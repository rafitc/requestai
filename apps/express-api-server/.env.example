# =============================================================================
# RequestAi Express API Server — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to one of the following, depending on the target environment:
#   - .env.development.local   (default when NODE_ENV is unset)
#   - .env.development
#   - .env.staging
#   - .env.production
#
# The loader (src/util/configUtil.ts) picks the file based on NODE_ENV.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# One of: development.local | development | staging | production | test
NODE_ENV=development.local

# Human-readable name used in startup logs and OpenAPI metadata
SERVICE_NAME=RequestAi

# HTTP port the Express server listens on
PORT=3020

# When true, the primary process forks one worker per CPU (capped at 1 in dev)
HAS_CLUSTERING_ENABLED=false

# Optional escape hatch for template-specific config consumed by config/index.ts
CUSTOM_TEMPLATE_SPECIFIC_ENV_VAR=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of origins that may call this API from the browser.
# Wildcards are NOT allowed when CORS_CREDENTIALS=true — list each explicitly.
CORS_ALLOWED_ORIGINS=http://localhost:4020

# Whether to send Access-Control-Allow-Credentials: true. Required when the
# frontend (e.g. Better Auth client) sends requests with credentials: "include".
CORS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Logging (Winston)
# -----------------------------------------------------------------------------
# One of: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=silly

# Optional Slack incoming webhook for log forwarding (leave blank to disable)
LOGGING_TRANSPORT_SLACK_WEBHOOK_URL=

# Directory used for the file transport — created at runtime if missing
LOGGING_TRANSPORT_FILE_LOGS_DIRECTORY=./logs

# File names per log level
LOGGING_TRANSPORT_FILE_ERROR_LOG_FILE_NAME=error.log
LOGGING_TRANSPORT_FILE_WARN_LOG_FILE_NAME=warn.log
LOGGING_TRANSPORT_FILE_INFO_LOG_FILE_NAME=info.log
LOGGING_TRANSPORT_FILE_HTTP_LOG_FILE_NAME=http.log
LOGGING_TRANSPORT_FILE_VERBOSE_LOG_FILE_NAME=verbose.log
LOGGING_TRANSPORT_FILE_DEBUG_LOG_FILE_NAME=debug.log
LOGGING_TRANSPORT_FILE_SILLY_LOG_FILE_NAME=silly.log
LOGGING_TRANSPORT_FILE_COMBINED_LOG_FILE_NAME=combined.log

# -----------------------------------------------------------------------------
# Database (PostgreSQL via @requestai/database / Drizzle)
# -----------------------------------------------------------------------------
# Either provide DATABASE_URL OR all of the discrete params below.
# DATABASE_URL takes precedence when set.
DATABASE_URL=

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_USER_PASSWORD=postgres
DATABASE_NAME=requestai

# Pool tuning (defaults: 2 / 10 / 30000ms)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# Require SSL when connecting to the database
DB_SSL=false

# -----------------------------------------------------------------------------
# Better Auth (@requestai/better-auth)
# -----------------------------------------------------------------------------
# Must be at least 64 characters. Generate with:
#   openssl rand -hex 48
BETTER_AUTH_SECRET=replace-me-with-a-64-plus-character-secret-generated-via-openssl-rand-hex-48

# Public base URL of this API (used to build auth callbacks)
BETTER_AUTH_BASE_URL=http://localhost:3020

# Mount path for the better-auth router
BETTER_AUTH_BASE_PATH=/api/auth

# Set to "true" only when serving over HTTPS
BETTER_AUTH_COOKIE_SECURE=false

# One of: lax | strict | none
BETTER_AUTH_COOKIE_SAME_SITE=lax

# Wrap Better Auth responses in our { isSuccess, data, error } envelope.
# Keep this FALSE when using the Better Auth React/JS client, which expects
# raw responses ({ session, user, … }). Set to TRUE only if every consumer
# of /api/auth/* understands the envelope.
BETTER_AUTH_ENABLE_RESPONSE_ENVELOPE=false

# Comma-separated list of additional origins Better Auth will accept. The
# configured BETTER_AUTH_BASE_URL is trusted implicitly; this is for any
# other origin (typically your frontend) that calls the auth endpoints.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4020

# Google OAuth — leave both blank to disable Google sign-in.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BETTER_AUTH_BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Number of free credits granted to a new user at signup
SIGNUP_CREDIT_GRANT=3

# -----------------------------------------------------------------------------
# AI providers (configured here, NOT exposed to users)
# -----------------------------------------------------------------------------
# Which provider to use by default. One of: claude | openai
AI_DEFAULT_PROVIDER=claude

# Anthropic (Claude). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
AI_CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4.1

# -----------------------------------------------------------------------------
# Razorpay (payments) — enable International Payments in your dashboard
# to accept USD as well as INR.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Object storage (uploaded source docs + per-platform exports)
# Use local disk in dev; S3-compatible (Cloudflare R2 recommended) in prod.
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# -----------------------------------------------------------------------------
# Email — Mailgun (optional, leave blank if unused)
# -----------------------------------------------------------------------------
EMAIL_SERVICE_MAILGUN_DOMAIN=
EMAIL_SERVICE_MAILGUN_USERNAME=
EMAIL_SERVICE_MAILGUN_SENDING_API_KEY=
EMAIL_SERVICE_MAILGUN_PRIVATE_API_KEY=
# The mailbox part only; the domain above is appended automatically
EMAIL_SERVICE_MAILGUN_SENDER_ID=

# -----------------------------------------------------------------------------
# Email — Transactional SMTP (e.g. password resets, OTPs)
# -----------------------------------------------------------------------------
EMAIL_SERVICE_TRANSACTIONAL_SMTP_HOST=
EMAIL_SERVICE_TRANSACTIONAL_SMTP_PORT=587
EMAIL_SERVICE_TRANSACTIONAL_SMTP_SECURE=false
EMAIL_SERVICE_TRANSACTIONAL_SMTP_USERNAME=
EMAIL_SERVICE_TRANSACTIONAL_SMTP_PASSWORD=
EMAIL_SERVICE_TRANSACTIONAL_SMTP_FROM_ADDRESS=

# -----------------------------------------------------------------------------
# Email — Marketing SMTP (e.g. newsletters)
# -----------------------------------------------------------------------------
EMAIL_SERVICE_MARKETING_SMTP_HOST=
EMAIL_SERVICE_MARKETING_SMTP_PORT=587
EMAIL_SERVICE_MARKETING_SMTP_SECURE=false
EMAIL_SERVICE_MARKETING_SMTP_USERNAME=
EMAIL_SERVICE_MARKETING_SMTP_PASSWORD=
EMAIL_SERVICE_MARKETING_SMTP_FROM_ADDRESS=

# -----------------------------------------------------------------------------
# Dev-only mail redirect
# -----------------------------------------------------------------------------
# When set, every outbound email goes to this address regardless of the real
# recipient. The original recipient is preserved in the subject line.
# Useful when testing signup with throwaway addresses but you want all OTPs
# in a single inbox. Leave blank in production.
EMAIL_DEV_REDIRECT_TO=

# -----------------------------------------------------------------------------
# Email verification / OTP
# -----------------------------------------------------------------------------
EMAIL_VERIFICATION_OTP_CUSTOM_ALPHABET=0123456789
EMAIL_VERIFICATION_OTP_LENGTH=6
EMAIL_VERIFICATION_OTP_VALIDITY_IN_MINUTES=15
EMAIL_VERIFICATION_RETRY_INTERVAL_IN_MINUTES=5
